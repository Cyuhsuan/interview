APP_ENV=development
PORT=8080
CLINIC_TIMEZONE=America/New_York

# Optional. Exact browser origin allowed to call the API via CORS.
# Defaults to http://localhost:5173 (Vite dev server) when unset.
FRONTEND_ORIGIN=http://localhost:5173

DATABASE_URL=postgres://postgres:postgres@localhost:5432/backend?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME_MINUTES=5

# Scheduling/Booking computation parameters (see backend/README.md's
# "待診所確認" — actual clinic-approved values are not yet known; these are
# placeholder values for local development only).
CLINIC_SLOT_INTERVAL_MINUTES=30
CLINIC_MIN_LEAD_MINUTES=60
BOOKING_SESSION_TTL_MINUTES=15

# AI Provider adapter (internal/ai, OpenAI-compatible Chat Completions).
# See backend/README.md's "AI Provider Adapter Contract" — this is a
# development/test-time integration, not an approved production AI
# provider. Do not commit a real key; set it in your local .env only.
AI_PROVIDER_API_KEY=changeme
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_MODEL=gpt-4o-mini
